+    /* TAO Revival compatibility: original OpenSSL ECPrivateKey wallet records
+     * may use standard DER short-form sequence lengths (e.g. 0x74) instead
+     * of the long form used by older Bitcoin Core key serializers. Never
+     * bypass scalar validation or the recorded public-key verification. */
+    if (end - seckey < 1) {
+        return 0;
+    }
+    ptrdiff_t len;
+    if (!(*seckey & 0x80u)) {
+        /* Canonical one-octet length for a sequence shorter than 128 bytes. */
+        len = *seckey++;
+    } else {
+        ptrdiff_t lenb = *seckey & ~0x80u; seckey++;
+        if (lenb < 1 || lenb > 2) {
+            return 0;
+        }
+        if (end - seckey < lenb) {
+            return 0;
+        }
+        len = seckey[lenb-1] | (lenb > 1 ? seckey[lenb-2] << 8 : 0u);
+        seckey += lenb;
+    }
     if (end - seckey < len) {
